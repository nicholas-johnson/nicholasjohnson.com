      <li>
        <button type="button" class="themeToggle">Dark</button>
      </li>
    </ul>
  </nav>

  <nav class="techLinks">
    <ul>
      <li><a href="/javascript">JavaScript</a></li>
      <li><a href="/ruby">Ruby</a></li>
