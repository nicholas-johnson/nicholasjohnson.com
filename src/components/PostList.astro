---
import type { MarkdownInstance } from "astro";
import { markdown } from "@astropub/md";
import type { ICourse } from "../types/Course";
import type { LinearHorizonWriting } from "../data/linearHorizonWritings";
import { getFirstExercisePath } from "../utils/getFirstExercisePath";
import { formatDate, writingTimestamp } from "../utils/formatDate";

interface Props {
  posts: MarkdownInstance<Record<string, any>>[];
  courses?: ICourse[];
  writings?: LinearHorizonWriting[];
}

const { posts, courses = [], writings = [] } = Astro.props;

const minutesFor = (text: string) =>
  Math.max(1, Math.round(text.split(/\s+/).filter(Boolean).length / 250));

const kindLabel = (kind: LinearHorizonWriting["kind"]) =>
  kind === "whitepaper" ? "Whitepaper" : "Linear Horizon";

const datedWritings = [
  ...posts.map((post) => {
    const preview = post.frontmatter.preview || "";
    return {
      title: post.frontmatter.seoTitle || post.frontmatter.title,
      href: post.url ?? "",
      preview,
      date: post.frontmatter.date as string,
      extra: `${minutesFor(post.rawContent())} min read`,
    };
  }),
  ...writings.map((writing) => ({
    title: writing.title,
    href: writing.href,
    preview: writing.description,
    date: writing.date,
    extra: writing.body
      ? `${kindLabel(writing.kind)} · ${minutesFor(writing.body)} min read`
      : kindLabel(writing.kind),
  })),
].sort((a, b) => writingTimestamp(b.date) - writingTimestamp(a.date));

const coursePreview = (course: ICourse) =>
  course.description.trim() || course.exercises[0]?.description || "";
---

<ul class="postList">
  {
    courses.map((course) => {
      const href = getFirstExercisePath(course);
      const updated = formatDate(course.lastUpdatedAt);
      return (
      <li class="post course">
        {course.cover && (
          <a class="cover" href={href}>
            <img src={course.cover} alt={course.coverAlt || course.title} />
          </a>
        )}
        <div class="body">
          <h2>
            <a href={href}>{course.title}</a>
          </h2>
          {markdown(coursePreview(course))}
          <p class="meta">
            Course
            {updated && <> · Last updated {updated}</>}
          </p>
        </div>
      </li>
      );
    })
  }
  {
    datedWritings.map((writing) => {
      const updated = formatDate(writing.date);
      return (
      <li class="post">
        <h2>
          <a href={writing.href}>{writing.title}</a>
        </h2>
        {markdown(writing.preview || "")}
        <p class="meta">
          {updated && <>{updated} · </>}
          {writing.extra}
        </p>
      </li>
      );
    })
  }

  <style lang="scss">
    ul,
    li {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    p.meta {
      font-size: 0.8rem;

      letter-spacing: 0.01rem;
      text-align: right;
      border-top: 1px dashed var(--colour-muted);
      color: var(--colour-muted);
    }

    li.post {
      margin: 2rem 0;
    }

    h2 a {
      text-decoration: none;
      color: var(--colour-text);
      &:hover {
        color: var(--colour-link);
        text-decoration: underline;
      }
    }

    a.cover {
      display: block;
      flex: 0 0 11rem;
      img {
        display: block;
        width: 11rem;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 0.5rem;
      }
    }

    li.course {
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;

      .body {
        flex: 1;
        min-width: 0;
      }

      h2 {
        margin-top: 0;
      }

      @media (max-width: 600px) {
        flex-direction: column;

        a.cover,
        a.cover img {
          width: 100%;
        }
      }
    }
  </style>
</ul>
