---
import type { MarkdownInstance } from "astro";
import { markdown } from "@astropub/md";

interface Props {
  posts: MarkdownInstance<Record<string, any>>[];
}

const { posts } = Astro.props;

const formatDate = (value: string | undefined) => {
  const date = new Date(value ?? "");
  if (Number.isNaN(date.getTime())) return null;
  return date.toLocaleDateString(undefined, {
    year: "numeric",
    month: "long",
  });
};
---

<ul class="postList">
  {
    posts.map((post) => {
      const updated = formatDate(post.frontmatter.date);
      const wordCount = post.rawContent().split(" ").length;
      const minutes = Math.max(1, Math.round(wordCount / 250));
      return (
      <li class="post">
        <h2>
          <a href={post.url}>
            {post.frontmatter.seoTitle || post.frontmatter.title}
          </a>
        </h2>
        {markdown(post.frontmatter.preview || "")}
        <p class="meta">
          {updated && <>{updated} · </>}
          {minutes} min read
        </p>
      </li>
      );
    })
  }

  <style lang="scss">
    @import "../styles/variables.scss";

    ul,
    li {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    p.meta {
      font-size: 0.8rem;

      letter-spacing: 0.01rem;
      text-align: right;
      border-top: 1px dashed $colour-muted;
      color: $colour-muted;
    }

    li.post {
      margin: 2rem 0;
    }

    h2 a {
      text-decoration: none;
      color: $colour-text;
      &:hover {
        color: $colour-link;
        text-decoration: underline;
      }
    }
  </style>
</ul>
