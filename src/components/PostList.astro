---
import type { MarkdownInstance } from "astro";
import { markdown } from "@astropub/md";
import type { ICourse } from "../types/Course";
import { getFirstExercisePath } from "../utils/getFirstExercisePath";

interface Props {
  posts: MarkdownInstance<Record<string, any>>[];
  courses?: ICourse[];
}

const { posts, courses = [] } = Astro.props;

const formatDate = (value: string | undefined) => {
  const date = new Date(value ?? "");
  if (Number.isNaN(date.getTime())) return null;
  return date.toLocaleDateString(undefined, {
    year: "numeric",
    month: "long",
  });
};

const coursePreview = (course: ICourse) =>
  course.description.trim() || course.exercises[0]?.description || "";
---

<ul class="postList">
  {
    courses.map((course) => {
      const href = getFirstExercisePath(course);
      return (
      <li class="post course">
        {course.cover && (
          <a class="cover" href={href}>
            <img src={course.cover} alt={course.coverAlt || course.title} />
          </a>
        )}
        <div class="body">
          <h2>
            <a href={href}>{course.title}</a>
          </h2>
          {markdown(coursePreview(course))}
          <p class="meta">Course</p>
        </div>
      </li>
      );
    })
  }
  {
    posts.map((post) => {
      const updated = formatDate(post.frontmatter.date);
      const wordCount = post.rawContent().split(" ").length;
      const minutes = Math.max(1, Math.round(wordCount / 250));
      return (
      <li class="post">
        <h2>
          <a href={post.url}>
            {post.frontmatter.seoTitle || post.frontmatter.title}
          </a>
        </h2>
        {markdown(post.frontmatter.preview || "")}
        <p class="meta">
          {updated && <>{updated} · </>}
          {minutes} min read
        </p>
      </li>
      );
    })
  }

  <style lang="scss">
    ul,
    li {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    p.meta {
      font-size: 0.8rem;

      letter-spacing: 0.01rem;
      text-align: right;
      border-top: 1px dashed var(--colour-muted);
      color: var(--colour-muted);
    }

    li.post {
      margin: 2rem 0;
    }

    h2 a {
      text-decoration: none;
      color: var(--colour-text);
      &:hover {
        color: var(--colour-link);
        text-decoration: underline;
      }
    }

    a.cover {
      display: block;
      flex: 0 0 11rem;
      img {
        display: block;
        width: 11rem;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 0.5rem;
      }
    }

    li.course {
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;

      .body {
        flex: 1;
        min-width: 0;
      }

      h2 {
        margin-top: 0;
      }

      @media (max-width: 600px) {
        flex-direction: column;

        a.cover,
        a.cover img {
          width: 100%;
        }
      }
    }
  </style>
</ul>
