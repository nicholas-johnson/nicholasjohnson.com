---
import GlobalLayout from "../layouts/GlobalLayout.astro";

import PostList from "../components/PostList.astro";
import { learnToCodeWithJavaScript } from "../data/learnToCodeWithJavascript";
import { javascriptForProgrammers } from "../data/javascriptForProgrammers";
import { pythonForMachineLearning } from "../data/pythonForMachineLearning";
import { rubyCourse } from "../data/rubyCourse";
import { webDevCourse } from "../data/webDevCourse";
import CourseList from "../components/CourseList.astro";

const allPosts = await Astro.glob("./posts/*.md");

const posts = allPosts
  .filter((post) => {
    if (post.frontmatter.unpublished || post.frontmatter.unpublish) {
      return false;
    }
    return !Number.isNaN(Date.parse(post.frontmatter.date));
  })
  .sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));
---

<GlobalLayout title="Nicholas Johnson.com">
  <div class="home">
    <div class="main">
      <div class="intro">
        <div class="imageHost">
          <img src="/images/me.jpg" alt="Nick Johnson" />
        </div>

        <div class="textHost">
          <h1>Hi, I'm Nick Johnson!</h1>
          <p>
            Previously Front End Lead at Beamery. Currently Principal Engineer
            at Cencora. BSc in Artificial Intelligence.
          </p>

          <p>
            If you have an interesting project, possibly AI related, please feel
            free to get in touch at <a href="mailto:hello@nicholasjohnson.com"
              >hello@nicholasjohnson.com</a
            >. I'll be glad to have a chat.
          </p>

          <p>
            I also write free courses you can work through at your own pace, and
            run
            <a href="/courses">instructor-led training</a> internationally.
          </p>
        </div>
      </div>
      <h2>Writings</h2>
      <PostList posts={posts} />
    </div>

    <div class="sidebar">
      <h2>Free courses</h2>

      <div class="courseLinks">
        <CourseList
          courses={[
            learnToCodeWithJavaScript,
            webDevCourse,
            pythonForMachineLearning,
            javascriptForProgrammers,
            rubyCourse,
          ]}
        />
      </div>
    </div>
  </div>

  <style lang="scss">
    @import "../styles/variables.scss";

    .home {
      display: flex;
      justify-content: space-between;
      gap: 4rem;

      @media (max-width: 1000px) {
        flex-direction: column;
      }
    }

    .main {
      max-width: 50rem;
      flex: 1;
    }

    .intro {
      display: flex;
      gap: 2rem;
      border-left: 3px solid $colour-brand;
      padding-left: 2rem;
      margin: 3rem 0;

      .imageHost {
        flex: 1;
        max-width: 16rem;
        img {
          display: block;
          width: 100%;
          aspect-ratio: 4 / 5;
          object-fit: cover;
          object-position: top center;
          border-radius: 0.5rem;
        }
      }
      .textHost {
        flex: 1;
      }

      h1 {
        margin-top: 0;
      }

      @media (max-width: 1100px) {
        border-left: none;
        padding-left: 0;
      }

      @media (max-width: 600px) {
        flex-direction: column-reverse;

        .imageHost {
          width: 16rem;
          max-width: 16rem;
          margin: 0 auto;
        }
      }
    }

    .sidebar {
      max-width: 20rem;
      margin-top: 4rem;

      h2 {
        padding-left: 2rem;
      }

      .courseLinks {
        border-left: 1px dashed $colour-muted;
        padding-left: 2rem;
      }
    }
  </style>
</GlobalLayout>
