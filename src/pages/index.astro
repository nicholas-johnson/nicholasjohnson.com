---
import GlobalLayout from "../layouts/GlobalLayout.astro";

import PostList from "../components/PostList.astro";
import { learnToCodeWithJavaScript } from "../data/learnToCodeWithJavascript";
import { javascriptForProgrammers } from "../data/javascriptForProgrammers";
import { pythonForMachineLearning } from "../data/pythonForMachineLearning";
import { rubyCourse } from "../data/rubyCourse";
import { webDevCourse } from "../data/webDevCourse";

const allPosts = await Astro.glob("./posts/*.md");

const posts = allPosts
  .filter((post) => {
    if (post.frontmatter.unpublished || post.frontmatter.unpublish) {
      return false;
    }
    return !Number.isNaN(Date.parse(post.frontmatter.date));
  })
  .sort((a, b) => Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date));

const linearHorizonCourses = [
  {
    title: "AI Engineering with Python",
    slug: "ai-engineering",
    duration: "3 days",
  },
  {
    title: "Applied NLP with Python",
    slug: "applied-nlp",
    duration: "2 days",
  },
  {
    title: "Generative AI Fundamentals",
    slug: "generative-ai-fundamentals",
    duration: "1 day",
  },
  {
    title: "Building AI Agents",
    slug: "building-ai-agents",
    duration: "2 days",
  },
  {
    title: "RAG: From Fundamentals to Production",
    slug: "rag-from-fundamentals-to-production",
    duration: "2 days",
  },
  {
    title: "Production AI Architecture",
    slug: "production-ai-architecture",
    duration: "2 days",
  },
  {
    title: "AI for Technical Leaders",
    slug: "ai-for-technical-leaders",
    duration: "1 day",
  },
];
---

<GlobalLayout title="Nicholas Johnson.com">
  <div class="home">
    <div class="main">
      <div class="intro">
        <div class="imageHost">
          <img src="/images/me.jpeg" alt="Nick Johnson" />
        </div>

        <div class="textHost">
          <h1>Hi, I'm Nick Johnson!</h1>
          <p>
            I'm a Principal AI Product Engineer at Cencora, building
            skunkworks products at enterprise scale. Previously an early hire at
            Beamery (now $1bn), Brandwatch ($450m acquisition), and Higgidy
            (acquired), and lead engineer at Streetbank. I founded
            <a href="https://fictionite.com">Fictionite</a> and
            <a href="https://linearhorizon.com">Linear Horizon</a>.
          </p>

          <p>
            If you have an interesting project, possibly AI related, please feel
            free to get in touch at <a href="mailto:hello@nicholasjohnson.com"
              >hello@nicholasjohnson.com</a
            >. I'll be glad to have a chat.
          </p>

          <p>
            I also write free courses you can work through at your own pace, and
            run
            <a href="/courses">instructor-led training</a> internationally.
          </p>
        </div>
      </div>
      <div class="feed">
        <PostList
          courses={[
            learnToCodeWithJavaScript,
            webDevCourse,
            pythonForMachineLearning,
            javascriptForProgrammers,
            rubyCourse,
          ]}
          posts={posts}
        />
      </div>
    </div>

    <div class="sidebar">
      <div class="courseLinks">
        <ul>
          {
            linearHorizonCourses.map((course) => (
              <li>
                <a href={`https://linearhorizon.com/training/${course.slug}`}>
                  {course.title}
                </a>
                <span class="duration">{course.duration}</span>
              </li>
            ))
          }
        </ul>
        <p class="catalogue">
          <a href="https://linearhorizon.com/training">Full catalogue</a>
        </p>
      </div>
    </div>
  </div>

  <style lang="scss">
    .home {
      display: flex;
      justify-content: space-between;
      gap: 4rem;

      @media (max-width: 1000px) {
        flex-direction: column;
      }
    }

    .main {
      max-width: 50rem;
      flex: 1;
    }

    .feed {
      margin-top: 3rem;
    }

    .intro {
      display: flex;
      flex-direction: row-reverse;
      gap: 2rem;
      border-left: 3px solid var(--colour-brand);
      padding-left: 2rem;
      margin: 3rem 0;

      .imageHost {
        flex: 1;
        max-width: 16rem;
        img {
          display: block;
          width: 100%;
          aspect-ratio: 4 / 5;
          object-fit: cover;
          object-position: 72% 20%;
          border-radius: 0.5rem;
        }
      }
      .textHost {
        flex: 1;
      }

      h1 {
        margin-top: 0;
      }

      @media (max-width: 1100px) {
        border-left: none;
        padding-left: 0;
      }

      @media (max-width: 600px) {
        flex-direction: column-reverse;

        .imageHost {
          width: 16rem;
          max-width: 16rem;
          margin: 0 auto;
        }
      }
    }

    .sidebar {
      max-width: 20rem;
      margin-top: 3rem;
      font-size: 0.875rem;

      .courseLinks {
        border-left: 1px dashed var(--colour-muted);
        padding-left: 2rem;
      }

      ul,
      li {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      ul {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      a {
        color: var(--colour-muted);
        text-decoration: none;
        transition: color 400ms ease;

        &:hover {
          color: var(--colour-link);
          text-decoration: underline;
        }
      }

      .duration {
        display: block;
        font-size: 0.75rem;
        color: var(--colour-muted);
        opacity: 0.8;
      }

      .catalogue {
        margin-top: 1.5rem;
      }

      @media (max-width: 1000px) {
        margin-top: 1rem;
      }
    }
  </style>
</GlobalLayout>
